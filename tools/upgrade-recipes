def http_get(url: str, timeout: int = 30, binary: bool = False, accept: str = ""):
    headers = {"User-Agent": UA}
    if accept:
        headers["Accept"] = accept
    token = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if token and "api.github.com" in url:
        headers["Authorization"] = f"Bearer {token}"
    req = Request(url, headers=headers)
    ctx = ssl.create_default_context()
    try:
        with urlopen(req, timeout=timeout, context=ctx) as resp:
            data = resp.read()
            if binary:
                return data
            return data.decode("utf-8", errors="replace")
    except HTTPError as exc:
        raise HttpError(f"{url}: HTTP {exc.code}") from exc
    except URLError as exc:
        raise HttpError(f"{url}: {exc.reason}") from exc


def version_tokens(version: str) -> list[tuple[str, str]]:
    tokens = []
    i = 0
    v = version or ""
    while i < len(v):
        c = v[i]
        if c == "~":
            tokens.append(("tilde", c))
            i += 1
        elif c.isdigit():
            j = i
            while j < len(v) and v[j].isdigit():
                j += 1
            tokens.append(("number", v[i:j]))
            i = j
        elif c.isalpha():
            j = i
            while j < len(v) and v[j].isalpha():
                j += 1
            tokens.append(("text", v[i:j].lower()))
            i = j
        else:
            i += 1
    return tokens


def version_compare(left: str, right: str) -> int:
    lt, rt = version_tokens(left), version_tokens(right)
    n = max(len(lt), len(rt))
    for i in range(n):
        if i >= len(lt):
            rest = rt[i:]
            if rest and rest[0][0] == "tilde":
                return 1
            return -1 if rest else 0
        if i >= len(rt):
            rest = lt[i:]
            if rest and rest[0][0] == "tilde":
                return -1
            return 1 if rest else 0
        (lt_t, lt_v), (rt_t, rt_v) = lt[i], rt[i]
        if lt_t == "tilde" or rt_t == "tilde":
            if lt_t == rt_t:
                continue
            return -1 if lt_t == "tilde" else 1
        if lt_t == "number" and rt_t == "number":
            a, b = lt_v.lstrip("0") or "0", rt_v.lstrip("0") or "0"
            if len(a) != len(b):
                return -1 if len(a) < len(b) else 1
            if a != b:
                return -1 if a < b else 1
            continue
        if lt_t != rt_t:
            return -1 if lt_t == "number" else 1
        if lt_v != rt_v:
            return -1 if lt_v < rt_v else 1
    return 0


def version_newer(candidate: str, current: str) -> bool:
    return version_compare(candidate, current) > 0


def is_prerelease(version: str) -> bool:
    if not version:
        return True
    if PRE_RE.search(version):
        return True
    return False


def gnome_stable(name: str, version: str) -> bool:
    key = name.lower().replace("gtk4", "gtk")
    if key not in GNOME_EVEN and name.lower() not in GNOME_EVEN:
        return True
    parts = re.findall(r"\d+", version)
    if len(parts) < 2:
        return True
    return int(parts[1]) % 2 == 0


def parse_recipe(path: Path) -> dict:
    rec = {
        "path": path,
        "name": "",
        "version": "",
        "release": "1",
        "arch": "",
        "description": "",
        "source": [],
        "hash": [],
        "depend": [],
        "builddep": [],
        "optional": [],
        "conflict": [],
        "prepare": [],
        "configure": [],
        "build": [],
        "install": [],
        "raw": path.read_text(encoding="utf-8"),
    }
    key = None
    buf = []
    for line in rec["raw"].splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        if line.endswith("\\"):
            piece = line[:-1]
            if key is None:
                parts = piece.split(None, 1)
                if len(parts) != 2:
                    continue
                key, val = parts[0], parts[1]
                buf = [val]
            else:
                buf.append(piece.strip())
            continue
        if key is not None:
            buf.append(line.strip())
            rec.setdefault(key, [])
            if key in rec and isinstance(rec[key], list):
                rec[key].append(" ".join(buf).strip())
            key = None
            buf = []
            continue
        parts = line.split(None, 1)
        if len(parts) != 2:
            continue
        k, v = parts[0], parts[1]
        if k in ("name", "version", "release", "arch", "description"):
            rec[k] = v
        elif k in rec and isinstance(rec[k], list):
            rec[k].append(v)
    rec["names"] = rec["name"]
    return rec


def recipe_has_source(rec: dict) -> bool:
    return bool(rec.get("source"))


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def cache_path(url: str) -> Path:
    CACHE.mkdir(parents=True, exist_ok=True)
    name = hashlib.sha256(url.encode()).hexdigest()[:20] + "-" + url.rstrip("/").split("/")[-1][:80]
    return CACHE / name


def download(url: str) -> Path:
    dest = cache_path(url)
    if dest.exists() and dest.stat().st_size > 0:
        return dest
    tmp = dest.with_suffix(dest.suffix + ".part")
    data = http_get(url, timeout=120, binary=True)
    tmp.write_bytes(data)
    tmp.replace(dest)
    return dest


def strip_tag(tag: str) -> str:
    tag = tag.strip()
    tag = re.sub(r"^(refs/tags/)", "", tag)
    tag = re.sub(r"^(v|V|release-|Release-|version-|VERSION-)", "", tag)
    tag = re.sub(r"^(llvmorg-)", "", tag)
    return tag.lstrip("v")


def github_repo(url: str) -> tuple[str, str] | None:
    m = re.search(r"github\.com/([^/]+)/([^/]+)", url)
    if not m:
        return None
    owner, repo = m.group(1), m.group(2)
    repo = re.sub(r"\.git$", "", repo)
    return owner, repo


def latest_github(owner: str, repo: str) -> str | None:
    try:
        body = http_get(
            f"{GITHUB_API}/repos/{owner}/{repo}/releases/latest",
            accept="application/vnd.github+json",
        )
        data = json.loads(body)
        tag = data.get("tag_name") or ""
        if data.get("prerelease") or data.get("draft"):
            tag = ""
        ver = strip_tag(tag)
        if ver and not is_prerelease(ver):
            return ver
    except (HttpError, json.JSONDecodeError, TypeError):
        pass
    try:
        body = http_get(
            f"{GITHUB_API}/repos/{owner}/{repo}/tags?per_page=30",
            accept="application/vnd.github+json",
        )
        tags = json.loads(body)
        best = None
        for item in tags:
            ver = strip_tag(item.get("name") or "")
            if not ver or is_prerelease(ver):
                continue
            if best is None or version_newer(ver, best):
                best = ver
        return best
    except (HttpError, json.JSONDecodeError, TypeError):
        return None


def latest_repology(name: str) -> str | None:
    try:
        body = http_get(REPOLOGY.format(name), timeout=40)
        rows = json.loads(body)
    except (HttpError, json.JSONDecodeError):
        return None
    best = None
    for row in rows:
        if row.get("status") not in {"newest", "unique"}:
            continue
        ver = str(row.get("version") or "")
        if not ver or is_prerelease(ver):
            continue
        if not gnome_stable(name, ver):
            continue
        if best is None or version_newer(ver, best):
            best = ver
    return best


def latest_gnome(url: str, name: str) -> str | None:
    m = re.search(r"download\.gnome\.org/sources/([^/]+)/", url)
    module = m.group(1) if m else name
    try:
        body = http_get(f"https://download.gnome.org/sources/{module}/cache.json")
        data = json.loads(body)
    except (HttpError, json.JSONDecodeError):
        return None
    versions = []
    if isinstance(data, list) and len(data) >= 2 and isinstance(data[1], dict):
        pkgmap = data[1].get(module) or data[1].get(name) or {}
        for series, items in pkgmap.items():
            if not gnome_stable(module, series + ".0"):
                continue
            if isinstance(items, list):
                versions.extend(str(x) for x in items)
    best = None
    for ver in versions:
        if is_prerelease(ver):
            continue
        if not gnome_stable(module, ver):
            continue
        if best is None or version_newer(ver, best):
            best = ver
    return best


def latest_gnu(url: str, name: str) -> str | None:
    parsed = urlparse(url)
    directory = url.rsplit("/", 1)[0] + "/"
    try:
        body = http_get(directory)
    except HttpError:
        return None
    versions = re.findall(
        rf"href=\"{re.escape(name)}-([0-9][0-9A-Za-z.+~_-]*)\.(?:tar\.(?:gz|xz|bz2|lz)|tgz)\"",
        body,
    )
    best = None
    for ver in versions:
        if is_prerelease(ver):
            continue
        if best is None or version_newer(ver, best):
            best = ver
    return best


def latest_qemu() -> str | None:
