def latest_pypi(name: str) -> str | None:
    try:
        body = http_get(f"https://pypi.org/pypi/{name}/json")
        data = json.loads(body)
        ver = data.get("info", {}).get("version")
        if ver and not is_prerelease(ver):
            return ver
    except (HttpError, json.JSONDecodeError):
        return None
    return None


def detect_latest(rec: dict) -> str | None:
    name = rec["name"]
    url = rec["source"][0] if rec["source"] else ""
    found: list[str] = []

    if "download.qemu.org" in url or name == "qemu":
        v = latest_qemu()
        if v:
            found.append(v)
    if "download.gnome.org" in url:
        v = latest_gnome(url, name)
        if v:
            found.append(v)
    if "ftp.gnu.org" in url or "ftpmirror.gnu.org" in url:
        v = latest_gnu(url, name)
        if v:
            found.append(v)
    gh = github_repo(url)
    if gh:
        v = latest_github(*gh)
        if v:
            found.append(v)
    if "pypi.org" in url or "files.pythonhosted.org" in url:
        v = latest_pypi(name)
        if v:
            found.append(v)

    v = latest_repology(name)
    if v:
        found.append(v)

    best = None
    for ver in found:
        if is_prerelease(ver):
            continue
        if not gnome_stable(name, ver):
            continue
        if best is None or version_newer(ver, best):
            best = ver
    return best


def _series(version: str) -> str:
    parts = version.split(".")
    if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
        return f"{parts[0]}.{parts[1]}"
    return version


def rewrite_url(url: str, old: str, new: str) -> str:
    if not old or old == new:
        return url
    updated = url
    variants = [
        (old, new),
        (old.replace(".", "_"), new.replace(".", "_")),
        (old.replace(".", "-"), new.replace(".", "-")),
        (old.replace(".", ""), new.replace(".", "")),
    ]
    for a, b in variants:
        if a and a in updated:
            updated = updated.replace(a, b)
            break
    old_s, new_s = _series(old), _series(new)
    if old_s != new_s and f"/{old_s}/" in updated:
        updated = updated.replace(f"/{old_s}/", f"/{new_s}/")
    return updated


def extract_archive(archive: Path, dest: Path) -> Path:
    dest.mkdir(parents=True, exist_ok=True)
    name = archive.name.lower()
    if name.endswith(".zip"):
        with zipfile.ZipFile(archive) as zf:
            zf.extractall(dest)
    else:
        with tarfile.open(archive, "r:*") as tf:
            try:
                tf.extractall(dest, filter="data")
            except TypeError:
                tf.extractall(dest)
    children = [p for p in dest.iterdir() if p.name not in {".", ".."}]
    if len(children) == 1 and children[0].is_dir():
        return children[0]
    return dest


MESON_DEP = re.compile(
    r"""dependency\(\s*['\"]([^'\"]+)['\"]([^)]*)\)""",
    re.M,
)
CMAKE_PKG = re.compile(
    r"""find_package\(\s*([A-Za-z0-9_+.-]+)[^)]*REQUIRED""",
    re.M,
)
CMAKE_PC = re.compile(
    r"""pkg_check_modules\(\s*[A-Za-z0-9_]+\s+(?:REQUIRED\s+)?([A-Za-z0-9_+\-.]+)""",
    re.I,
)
AUTOCONF_PC = re.compile(
    r"""PKG_CHECK_MODULES\(\s*\[[^\]]+\]\s*,\s*\[([^\]>=]+)""",
)
PC_REQUIRES = re.compile(
    r"^(?:Requires(?:\.private)?):\s*(.+)$",
    re.M | re.I,
)


def scan_build_files(root: Path) -> tuple[set[str], set[str]]:
    """Return (runtime-ish names, build-ish names) as pkg-config/cmake ids."""
    runtime: set[str] = set()
    build: set[str] = set()
    files: list[Path] = []
    for pat in ("meson.build", "CMakeLists.txt", "configure.ac", "configure.in"):
        files.extend(root.rglob(pat))
    files.extend(root.rglob("*.pc.in"))
    files.extend(root.rglob("*.pc"))
    seen = 0
    for path in files:
        if seen > 80:
            break
        try:
            if path.stat().st_size > 2_000_000:
                continue
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        seen += 1
        name = path.name
        if name in {"meson.build", "meson_options.txt"}:
            for match in MESON_DEP.finditer(text):
                pc, rest = match.group(1), match.group(2)
                if re.search(r"required\s*:\s*false", rest, re.I):
                    continue
                runtime.add(pc)
        elif name == "CMakeLists.txt":
            for match in CMAKE_PKG.finditer(text):
                runtime.add(match.group(1))
            for match in CMAKE_PC.finditer(text):
                runtime.add(match.group(1).split()[0])
        elif name in {"configure.ac", "configure.in"}:
            for match in AUTOCONF_PC.finditer(text):
                runtime.add(match.group(1).strip().split()[0])
        elif name.endswith(".pc") or name.endswith(".pc.in"):
            for match in PC_REQUIRES.finditer(text):
                for tok in re.split(r"[ ,]+", match.group(1)):
                    tok = re.sub(r"[<>=].*$", "", tok).strip()
                    if tok:
                        runtime.add(tok)
    return runtime, build


def map_dep(raw: str, known: dict[str, Path]) -> str | None:
    raw = raw.strip()
    if not raw or raw in SKIP_DEPS:
        return None
    if raw in PC_MAP:
        mapped = PC_MAP[raw]
        return mapped if mapped in known else mapped
    lower = raw.lower()
    if lower in known:
        return lower
    if raw in known:
        return raw
    slug = lower.replace("_", "-")
    if slug in known:
        return slug
    if slug.startswith("lib") and slug[3:] in known:
        return slug[3:]
    if not slug.startswith("lib") and f"lib{slug}" in known:
        return f"lib{slug}"
    # gtk+-3.0 -> gtk3 already in map; qt6 bits
    m = re.match(r"qt6(.+)", slug)
    if m:
        cand = "qt6-qt" + m.group(1).lower()
        if cand in known:
            return cand
    return None


def load_tree_names(trees: list[Path]) -> dict[str, Path]:
    names: dict[str, Path] = {}
    for tree in trees:
        for recipe in tree.rglob("recipe"):
            rec = parse_recipe(recipe)
            if rec["name"]:
                names[rec["name"]] = recipe
    return names


def rewrite_recipe(rec: dict, new_ver: str, new_urls: list[str], new_hashes: list[str],
                   extra_depend: list[str], extra_builddep: list[str]) -> str:
    old_ver = rec["version"]
    lines = rec["raw"].splitlines()
    out: list[str] = []
    hash_i = 0
    source_i = 0
    seen_depend = False
    inserted_deps = False
    have_depend = set(rec["depend"])
    have_build = set(rec["builddep"])

    def flush_new_deps(dest: list[str]) -> None:
        nonlocal inserted_deps
        if inserted_deps:
            return
        for name in extra_depend:
            if name not in have_depend:
                dest.append(f"depend      {name}")
                have_depend.add(name)
        for name in extra_builddep:
            if name not in have_build:
                dest.append(f"builddep    {name}")
                have_build.add(name)
        inserted_deps = True

    for line in lines:
        if line.startswith("version"):
            out.append(f"version     {new_ver}")
            continue
        if line.startswith("release"):
            out.append("release     1")
            continue
        if line.startswith("source"):
            if source_i < len(new_urls):
                out.append(f"source      {new_urls[source_i]}")
                source_i += 1
            else:
                out.append(rewrite_url(line, old_ver, new_ver) if old_ver else line)
            continue
        if line.startswith("hash"):
            if hash_i < len(new_hashes):
                out.append(f"hash        sha256:{new_hashes[hash_i]}")
                hash_i += 1
            else:
                out.append(line)
            continue
        if line.startswith("depend"):
            seen_depend = True
            out.append(line)
            continue
        if seen_depend and not line.startswith(("depend", "builddep", "optional", "conflict")):
            flush_new_deps(out)
            seen_depend = False
        if old_ver and old_ver in line and line.startswith(("prepare", "configure", "build", "install")):
            out.append(line.replace(old_ver, new_ver))
            continue
        out.append(line)
    flush_new_deps(out)
    text = "\n".join(out)
    if not text.endswith("\n"):
        text += "\n"
    return text


def scaffold_recipe(tree: Path, name: str, version: str, url: str, digest: str,
                    depend: list[str]) -> Path:
    category = "libs"
    dest = tree / category / name
    dest.mkdir(parents=True, exist_ok=True)
    deps = "\n".join(f"depend      {d}" for d in (["filesystem"] + depend))
    body = (
        f"name        {name}\n"
        f"version     {version}\n"
        f"release     1\n"
        f"description {name}: auto-scaffolded runtime dependency\n"
        f"\n"
        f"source      {url}\n"
        f"hash        sha256:{digest}\n"
        f"\n"
        f"{deps}\n"
        f"\n"
        f"configure   ./configure --prefix=/usr --libdir=/usr/lib64 --disable-static\n"
        f"build       make -j\"$MAKEJOBS\"\n"
        f"install     make install DESTDIR=\"$PKG\"\n"
    )
    recipe = dest / "recipe"
    recipe.write_text(body, encoding="utf-8")
    return recipe


def guess_scaffold_url(name: str, version: str) -> str | None:
    # Common GitHub-style; last resort only.
    try:
        body = http_get(
            f"{GITHUB_API}/search/repositories?q={name}+in:name&per_page=3",
            accept="application/vnd.github+json",
        )
        data = json.loads(body)
        items = data.get("items") or []
        for item in items:
            if item.get("name", "").lower() != name.lower():
                continue
            full = item.get("full_name")
            if not full:
                continue
            return f"https://github.com/{full}/archive/refs/tags/v{version}.tar.gz"
    except (HttpError, json.JSONDecodeError):
        return None
    return None


def pin_group_key(name: str) -> int | None:
    for i, rx in enumerate(PIN_GROUPS):
        if rx.search(name):
            return i
    return None


class PlanItem:
    def __init__(self, rec: dict):
        self.rec = rec
        self.name = rec["name"]
        self.old = rec["version"]
        self.new = rec["version"]
        self.urls: list[str] = list(rec["source"])
        self.hashes: list[str] = []
        self.add_depend: list[str] = []
        self.add_builddep: list[str] = []
        self.missing: list[str] = []
        self.status = "current"
        self.detail = ""
        self.group: int | None = pin_group_key(self.name)


def collect_recipes(trees: list[Path], only: set[str] | None) -> list[dict]:
    recs = []
    for tree in trees:
        for recipe in sorted(tree.rglob("recipe")):
            rec = parse_recipe(recipe)
            if not rec["name"]:
                continue
            if only and rec["name"] not in only:
                continue
            recs.append(rec)
    return recs


def probe_one(rec: dict, include_kernel: bool) -> PlanItem:
    item = PlanItem(rec)
    name = rec["name"]
    if name in NO_AUTO and name not in {"qt6"}:
        item.status = "skip"
        item.detail = "metapackage or distro glue"
        return item
    if not include_kernel and name in {"linux", "linux-desktop", "linux-firmware"}:
        item.status = "skip"
        item.detail = "kernel/firmware (pass --include-kernel)"
        return item
    if not recipe_has_source(rec):
        item.status = "skip"
        item.detail = "no upstream source"
        return item
    try:
        latest = detect_latest(rec)
    except HttpError as exc:
        item.status = "error"
        item.detail = str(exc)
        return item
    if not latest:
        item.status = "unknown"
        item.detail = "could not detect a newer stable"
        return item
    if not version_newer(latest, rec["version"]):
        item.status = "current"
        item.new = rec["version"]
        return item
    item.new = latest
    item.status = "update"
    item.urls = [rewrite_url(u, rec["version"], latest) for u in rec["source"]]
    return item


def apply_pin_groups(items: list[PlanItem]) -> None:
    by_group: dict[int, list[PlanItem]] = {}
    for item in items:
        if item.group is None:
            continue
        by_group.setdefault(item.group, []).append(item)
    for members in by_group.values():
        best = None
        for item in members:
            if item.status in {"update", "current"}:
                if best is None or version_newer(item.new, best):
                    best = item.new
        if not best:
            continue
        for item in members:
            if item.status in {"skip", "error"}:
                continue
            if item.old != best:
                item.new = best
                item.status = "update"
                item.urls = [rewrite_url(u, item.old, best) for u in item.rec["source"]]
                item.detail = "pinned with sibling modules"


def inspect_new_deps(item: PlanItem, known: dict[str, Path]) -> None:
    if item.status != "update" or not item.urls:
        return
    url = item.urls[0]
    try:
        archive = download(url)
        item.hashes = [sha256_file(archive)]
        for extra in item.urls[1:]:
            item.hashes.append(sha256_file(download(extra)))
    except (HttpError, OSError) as exc:
        item.status = "error"
        item.detail = f"download failed: {exc}"
        return
    runtime, _build = set(), set()
    try:
        with tempfile.TemporaryDirectory(prefix="sps-upg-") as tmp:
            root = extract_archive(archive, Path(tmp) / "src")
            runtime, _build = scan_build_files(root)
    except (tarfile.TarError, zipfile.BadZipFile, OSError) as exc:
        item.detail = (item.detail + f" (scan skipped: {exc})").strip()
        return
    have = set()
    for spec in item.rec["depend"] + item.rec["builddep"]:
        have.add(re.split(r"[<>=]", spec, 1)[0])
    for raw in sorted(runtime):
        mapped = map_dep(raw, known)
        if mapped is None:
            if raw.lower() in SKIP_DEPS or raw in HOST_TOOLS:
                continue
            item.missing.append(raw)
            continue
        if mapped in have or mapped == item.name or mapped in HOST_TOOLS:
            continue
        if mapped not in known:
            item.missing.append(mapped)
            continue
        item.add_depend.append(mapped)
        have.add(mapped)


def write_item(item: PlanItem) -> None:
    text = rewrite_recipe(
        item.rec, item.new, item.urls, item.hashes,
        item.add_depend, item.add_builddep,
    )
    item.rec["path"].write_text(text, encoding="utf-8")


def format_plan(items: list[PlanItem]) -> str:
    lines = []
    counts = {}
    for item in items:
        counts[item.status] = counts.get(item.status, 0) + 1
        if item.status == "current":
            continue
        extra = ""
        if item.add_depend:
            extra += f"  +depend {', '.join(item.add_depend)}"
        if item.missing:
            extra += f"  missing {', '.join(item.missing)}"
        if item.detail:
            extra += f"  ({item.detail})"
        if item.status == "update":
            lines.append(f"UPDATE  {item.name:28} {item.old} -> {item.new}{extra}")
        elif item.status == "skip":
            lines.append(f"SKIP    {item.name:28} {item.detail}")
        elif item.status == "unknown":
            lines.append(f"UNKNOWN {item.name:28} {item.old} {item.detail}")
        else:
            lines.append(f"ERROR   {item.name:28} {item.detail}")
    summary = " ".join(f"{k}={v}" for k, v in sorted(counts.items()))
    lines.append(f"summary {summary}")
    return "\n".join(lines) + "\n"


def selftest() -> int:
    assert version_compare("1.2.3", "1.2.3") == 0
    assert version_compare("1.2.10", "1.2.9") > 0
    assert version_compare("2.0", "1.9.9") > 0
    assert version_compare("1.0~rc1", "1.0") < 0
    assert is_prerelease("1.2.3-rc1")
    assert not is_prerelease("1.2.3")
    assert gnome_stable("gtk", "4.22.4")
    assert not gnome_stable("gtk", "4.23.1")
    url = rewrite_url(
        "https://download.gnome.org/sources/gtk/4.18/gtk-4.18.6.tar.xz",
        "4.18.6", "4.22.4",
    )
    assert "4.22.4" in url and "4.18.6" not in url
    # series directory also rewritten
    assert "/4.22/" in url or "4.22.4" in url
    raw = map_dep("libssl", {"openssl": Path(".")})
    assert raw == "openssl"
    meson = "dependency('libpng', required: true)\ndependency('threads')\n"
    with tempfile.TemporaryDirectory() as tmp:
        p = Path(tmp)
        (p / "meson.build").write_text(meson, encoding="utf-8")
        runtime, _ = scan_build_files(p)
        assert "libpng" in runtime
        assert "threads" in runtime
    rec_text = (
        "name        demo\n"
        "version     1.0\n"
        "release     3\n"
        "description demo: test\n"
        "\n"
        "source      https://example.org/demo-1.0.tar.gz\n"
        "hash        sha256:" + ("a" * 64) + "\n"
        "\n"
        "depend      filesystem\n"
        "install     make install DESTDIR=\"$PKG\"\n"
    )
    with tempfile.TemporaryDirectory() as tmp:
        recipe = Path(tmp) / "recipe"
        recipe.write_text(rec_text, encoding="utf-8")
        rec = parse_recipe(recipe)
        assert rec["name"] == "demo"
        new = rewrite_recipe(rec, "1.1", ["https://example.org/demo-1.1.tar.gz"],
                             ["b" * 64], ["zlib"], [])
        assert "version     1.1" in new
        assert "release     1" in new
        assert "depend      zlib" in new
        assert "demo-1.1.tar.gz" in new
    print("selftest ok")
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description="Upgrade SPS recipes to the newest upstream stable release.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  tools/upgrade-recipes --trees /usr/src/sps/core:/usr/src/sps/extra\n"
            "  tools/upgrade-recipes --trees $PWD/../sps-core:$PWD/../sps-extra --apply\n"
            "  tools/upgrade-recipes --trees extra --only gtk4,qemu,llvm --apply\n"
        ),
    )
    ap.add_argument("--trees", default="",
                    help="colon-separated recipe trees (core:extra)")
    ap.add_argument("--apply", action="store_true",
                    help="write recipe changes (default is a plan only)")
    ap.add_argument("--scan-deps", action="store_true",
                    help="download new tarballs and scan for undeclared dependencies "
                         "(implied by --apply)")
    ap.add_argument("--no-scan-deps", action="store_true",
                    help="do not download tarballs or scan dependencies")
    ap.add_argument("--only", default="",
                    help="comma-separated package names")
    ap.add_argument("--jobs", type=int, default=8,
                    help="parallel upstream probes (default 8)")
    ap.add_argument("--include-kernel", action="store_true",
                    help="allow linux and firmware recipes")
    ap.add_argument("--scaffold-missing", action="store_true",
                    help="draft extra recipes for newly required unpackaged deps")
    ap.add_argument("--json", action="store_true",
                    help="print machine-readable plan")
    ap.add_argument("--selftest", action="store_true",
                    help="run offline unit checks and exit")
    args = ap.parse_args(argv)

    if args.selftest:
        return selftest()

    trees = [Path(p) for p in args.trees.split(":") if p]
    if not trees:
        env = os.environ.get("SPS_RECIPE_TREES", "")
        trees = [Path(p) for p in env.split(":") if p]
    if not trees:
        ap.error("pass --trees CORE:EXTRA (or set SPS_RECIPE_TREES)")

    for tree in trees:
        if not tree.is_dir():
            ap.error(f"recipe tree is not a directory: {tree}")

    only = {x.strip() for x in args.only.split(",") if x.strip()} or None
    recs = collect_recipes(trees, only)
    if not recs:
        log("no recipes found")
        return 1

    log(f"scanning {len(recs)} recipes in {len(trees)} tree(s)")
    items: list[PlanItem] = []
    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        futs = {pool.submit(probe_one, rec, args.include_kernel): rec for rec in recs}
        for fut in as_completed(futs):
            item = fut.result()
            items.append(item)
            if item.status == "update":
                log(f"plan  {item.name} {item.old} -> {item.new}")
    items.sort(key=lambda i: i.name)
    apply_pin_groups(items)

    known = load_tree_names(trees)
    extra_tree = trees[-1]
    updates = [i for i in items if i.status == "update"]
    do_scan = (args.apply or args.scan_deps) and not args.no_scan_deps
    if do_scan:
        for item in updates:
            log(f"fetch {item.name} {item.new}")
            inspect_new_deps(item, known)
            for miss in list(item.missing):
                mapped = map_dep(miss, known) or miss
                if mapped in known:
                    if mapped not in item.add_depend:
                        item.add_depend.append(mapped)
                    item.missing.remove(miss)
                    continue
                if not args.scaffold_missing:
                    continue
                latest = latest_repology(mapped) or item.new
                url = guess_scaffold_url(mapped, latest)
                if not url:
                    continue
                try:
                    archive = download(url)
                    digest = sha256_file(archive)
                except (HttpError, OSError):
                    continue
                path = scaffold_recipe(extra_tree, mapped, latest, url, digest, [])
                known[mapped] = path
                item.add_depend.append(mapped)
                item.missing.remove(miss)
                log(f"scaffold {mapped} -> {path}")
    elif args.apply:
        for item in updates:
            log(f"fetch {item.name} {item.new}")
            if not item.urls:
                item.status = "error"
                item.detail = "no source URL"
                continue
            try:
                item.hashes = [sha256_file(download(u)) for u in item.urls]
            except (HttpError, OSError) as exc:
                item.status = "error"
                item.detail = f"download failed: {exc}"

    if args.json:
        payload = []
        for item in items:
            payload.append({
                "name": item.name,
                "status": item.status,
                "old": item.old,
                "new": item.new,
                "urls": item.urls,
                "add_depend": item.add_depend,
                "missing": item.missing,
                "detail": item.detail,
            })
        print(json.dumps(payload, indent=2))
    else:
        sys.stdout.write(format_plan(items))

    if not args.apply:
        return 0 if not any(i.status == "error" for i in items) else 2

    written = 0
    for item in items:
        if item.status != "update":
            continue
        if not item.hashes:
            log(f"skip write {item.name}: no hash")
            continue
        write_item(item)
        written += 1
        log(f"wrote {item.rec['path']}")
    log(f"applied {written} recipe update(s)")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
